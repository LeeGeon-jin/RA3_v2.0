<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance" xmlns:xi="http://www.w3.org/2001/XInclude">
	<Tags></Tags>
	<Includes>
		<Include type="instance" source="DATA:Soviet/Units/SovietSupportBomber_Buildable.xml" />
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
	</Includes>

	<!-- Tech Airport Paradrop Bomber - Allied -->
	<GameObject
		id="TechAirportParadropBomber_Allied"
		inheritFrom="SovietSupportBomber_Buildable"
		Side="Allies"
		KindOf="-AIRCRAFT_TRANSPORT_ONLY_GARRISONABLE_WHILE_PARKED -LIMITED_PRODUCTION_AIRCRAFT +SUMMONED +IGNORES_SELECT_ALL +NO_COLLIDE -SELECTABLE"
		IsTrainable="false"
		EditorSorting="UNIT">
		<Behaviors>
			<TransportContain
				id="ModuleTag_Contain"
				xai:joinAction="Replace"
				ObjectStatusOfContained="UNSELECTABLE ENCLOSED"
				ContainMax="5"
				AllowEnemiesInside="false"
				AllowAlliesInside="true"
				AllowNeutralInside="false"
				AllowOwnPlayerInsideOverride="true"
				ShowPips="true"
				EnterSound="VehicleEnter"
				ExitSound="ParachutingOutOfAirplane"
				KillPassengersOnDeath="false"
				EjectPassengersOnDeath="true"
				ConditionForEntry="INVALID"
				ExtendedExitContainerChecks="true">
				<PassengerFilter
					Rule="ANY"
					Include="INFANTRY" />
				<DieMuxData
					DeathTypes="ALL" />
				<PassengerData
					BonePrefix="BONEGARRISON">
					<Filter
						Rule="NONE"
						Include="INFANTRY" />
				</PassengerData>
				<InitialPayload
					Name="AlliedAntiInfantryInfantry"
					Count="3" />
				<InitialPayload
					Name="AlliedAntiVehicleInfantry"
					Count="2" />
			</TransportContain>
			<SpecialPower
				id="ModuleTag_EjectPassengers"
				xai:joinAction="Replace"
				SpecialPowerTemplate="SpecialPower_EjectPassengers"
				UpdateModuleStartsAttack="true" />
			<EjectPassengersSpecialAbilityUpdate
				id="ModuleTag_EjectPassengersUpdate"
				xai:joinAction="Replace"
				SpecialPowerTemplate="SpecialPower_EjectPassengers"
				Height="150.0"
				StartAbilityRange="0.0"
				TimePerPassenger=".5s"
				Radius="0"
				RunOffMapWhenDone="true"
				IgnoreTargetLocation="true"
				Options="RECONSTITUTE_STORED_COMMAND DO_NOT_DO_AI_SPECIAL_POWER" />
			<RunOffMapBehavior
				id="ModuleTag_RunOffMapBehavior"
				xai:joinAction="Replace"
				FlyingOffMap="true"
				RequiresSpecificTrigger="true" />
			<WeaponSetUpdate
				id="ModuleTag_WeaponSetUpdate"
				xai:joinAction="Remove" />
		</Behaviors>
	</GameObject>

