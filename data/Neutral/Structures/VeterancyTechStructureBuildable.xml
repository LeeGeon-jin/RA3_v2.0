	<GameObject
		id="SovietVeterancyTechStructureBuildable"
		MaxSimultaneousOfType="1"
		inheritFrom="AlliedVeterancyTechStructureBuildable"
		Side="Soviet"
		BuildTime="0"
		EditorName="SovietVeterancyTechStructureBuildable">
		<Behaviors>
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="15s" />
		</Behaviors>
	</GameObject>

	<GameObject
		id="JapanVeterancyTechStructureBuildable"
		MaxSimultaneousOfType="1"
		inheritFrom="AlliedVeterancyTechStructureBuildable"
		Side="Japan"
		EditorName="JapanVeterancyTechStructureBuildable"
		BuildPlacementTypeFlag="OTHER_STRUCTURE" />

	<ObjectCreationList
		id="NUVeterancyTechStructureBuildable_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>NUVeterancyTechStructure_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>

	<!-- r18: invisible helper spawned when the building dies; removes the player upgrade, then deletes itself -->
	<GameObject
		id="VeterancyAcademyBuildableLostHelper"
		EditorSorting="SYSTEM"
		TransportSlotCount="0"
		IsTrainable="false"
		KindOf="UNATTACKABLE NOT_AUTOACQUIRABLE NO_COLLIDE INERT"
		EditorName="VeterancyAcademyBuildableLostHelper">
		<DisplayName>VeterancyAcademyBuildableLostHelper</DisplayName>
		<ArmorSet
			Armor="NoArmor" />
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model Name="" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<GrantUpgradeCreate
				id="ModuleTag_GrantTrigger"
				UpgradeToGrant="Upgrade_VeterancyAcademyLost" />
			<RemoveUpgradeUpgrade
				id="ModuleTag_RemovePlayerUpgrade">
				<TriggeredBy>Upgrade_VeterancyAcademyLost</TriggeredBy>
				<UpgradeToRemove>Upgrade_ProductionVeterancy_VETERAN</UpgradeToRemove>
			</RemoveUpgradeUpgrade>
			<LifetimeUpdate
				id="ModuleTag_Lifetime"
				MinLifetime="1s"
				MaxLifetime="1s" />
			<DestroyDie
				id="ModuleTag_DieDestroy">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
		</Behaviors>
		<Body>
			<PropBody
				id="ModuleTag_Body" />
		</Body>
		<Geometry
			IsSmall="true">
			<Shape
				Type="CYLINDER"
				MajorRadius="1.0"
				Height="1.0" />
		</Geometry>
	</GameObject>

	<ObjectCreationList
		id="OCL_VeterancyAcademyBuildableLost">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING">
			<CreateObject>VeterancyAcademyBuildableLostHelper</CreateObject>
		</CreateObject>
	</ObjectCreationList>
