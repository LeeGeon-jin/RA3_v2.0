			<AudioEntry EvaEvent="VeteranAcademyCaptured" AudioType="voiceDefectingTowards" />
			<AudioEntry Sound="TEC_VeteranAcademy_Select" AudioType="voiceSelect" />
		</AudioArrayVoice>
		<AudioArraySound>
