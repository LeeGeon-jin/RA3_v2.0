<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance">
	<Tags></Tags>
	<Includes>
		<Include type="instance" source="DATA:BaseObjects/BaseCivilianStructureNoGarrisonDestructible.xml" />
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
	</Includes>
	<GameObject
		id="JapanStatueGuard02Buildable"
		inheritFrom="BaseCivilianStructureNoGarrisonDestructible"
		EditorName="JapanStatueGuard02Buildable"
		KindOf="-NOT_AUTOACQUIRABLE"
		EditorSorting="STRUCTURE"
		Browser="REGION Tokyo_Harbor_TH STRUCTURE"
		Side="Japan"
		BuildTime="10"
		EnergyProduction="0"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE">
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="1000"/>
		</ObjectResourceInfo>

		<!-- Preserve NoArmor from prop parent (Replace parent DefaultArmor StructureArmor) -->
		<ArmorSet
			id="DefaultArmor"
			xai:joinAction="Replace"
			Armor="NoArmor" />

		<Draws>
			<!-- Convert DynamicsDraw to ScriptedModelDraw for static building -->
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="TH_StatueGuard02" />
				</ModelConditionState>
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<!-- no anim -->
				</AnimationState>
			</ScriptedModelDraw>
		</Draws>

		<Behaviors>
			<!-- ToppleUpdate removed (prop physics, not building) -->

			<!-- FXListBehavior preserved with Replace (rock crush FX) -->
			<FXListBehavior
				id="ModuleTag_FXList"
				xai:joinAction="Replace">
				<DieMuxData DeathTypes="ALL" />
				<Event Index="onDeath" FX="FX_RockCrush_AudioOnly" />
			</FXListBehavior>

			<!-- SlowDeath preserved -->
			<SlowDeath
				id="ModuleTag_Death"
				SinkDelay="1.5s"
				SinkRate="4"
				DestructionDelay="8s">
				<DieMuxData
					DeathTypes="ALL" />
			</SlowDeath>
		</Behaviors>

		<!-- Body: PropBody converted to ActiveBody with user-decided MaxHealth=2000 -->
		<Body>
			<ActiveBody
				id="DefaultBody"
				MaxHealth="2000" />
		</Body>

		<!-- Preserve original Guard02 geometry and offset from SDK -->
		<Geometry
			IsSmall="false">
			<Shape 
				Type="BOX"
				MajorRadius="9.0"
				MinorRadius="9.0"
				Height="44.0"
				ContactPointGeneration="STRUCTURE" >
				<Offset
					x="-0.143921"
					y="-0.225959"
					z="0.0" />
			</Shape>
		</Geometry>
	</GameObject>
</AssetDeclaration>
