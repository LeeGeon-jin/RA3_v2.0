<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance">
	<Tags></Tags>
	<Includes>
		<Include type="instance" source="DATA:BaseObjects/BaseCivilianStructureNoGarrisonDestructible.xml" />
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
		<Include type="instance" source="DATA:Civilian/Yucatan_YU/Props/YU_HotelDebris.xml" />
		<Include type="instance" source="DATA:Civilian/Easter_Island_EI/Props/EI_EasterIslandHeadDefense_Collapse.xml" />		
	</Includes>
	<GameObject
		id="EI_EasterIslandHeadDefense"
		inheritFrom="BaseCivilianStructureNoGarrisonDestructible"
		EditorName="EI_EasterIslandHeadDefense"
    	EditorSorting="STRUCTURE"
		Browser="REGION Easter_Island_EI STRUCTURE"
		RadarPriority="STRUCTURE"
		CommandSet="EI_EasterIslandHeadDefense"		
		BuildTime="0.0"
		EnergyProduction="0"
		SelectPortrait="Portrait_Special_EasterIslandDefense"
		ButtonImage="Button_Special_EasterIslandDefense"
		TypeDescription="Type:EasterIslandDefense"
		Description="Desc:EasterIslandDefense">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:EasterIslandDefense</DisplayName>
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				ExtraPublicBone="FX_Weapon_01 FX_WEAPON_02 FX_WEAPON_03">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="EI_EasterIslandHeadDefense_SKN" />
						<WeaponFireFXBone
							WeaponSlotID="1"
							WeaponSlotType="PRIMARY_WEAPON"
							BoneName="FX_WEAPON_02" />
						<Turret
							TurretNameKey="BONE_Rotate_Control"							
							TurretID="1" />
				</ModelConditionState>
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT"
					StateName="State_Idle">
					<Script>
						Prev = CurDrawablePrevAnimationState();
						if Prev == "State_Attacking" then
						CurDrawableSetTransitionAnimState("TRANS_EndAttack")
						end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="ENGAGED"
					StateName="State_Attacking"
					Flags="START_FRAME_LAST">
					<Animation
						AnimationName="EI_EasterIslandHeadDefense_GAG"						
						AnimationBlendTime="0"
						AnimationMode="MANUAL"/>
					<Script>
						Prev = CurDrawablePrevAnimationState();
						if Prev == "State_Idle" then
						CurDrawableSetTransitionAnimState("TRANS_StartAttack")
						end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_TRANSITION"
					StateName="TRANS_StartAttack">
					<Animation
						AnimationName="EI_EasterIslandHeadDefense_GAG"
						AnimationBlendTime="0"
						AnimationMode="ONCE"/>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_TRANSITION"
					StateName="TRANS_EndAttack"
					Flags="START_FRAME_LAST">
					<Animation
						AnimationName="EI_EasterIslandHeadDefense_GAG"
						AnimationBlendTime="0"
						AnimationMode="ONCE_BACKWARDS"/>
				</AnimationState>        
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics"/>

			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="YU_HotelDebris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>

			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_CIV_EasterIslandHead_Die" />
			</FXListBehavior>

			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="EI_EasterIslandHeadDefense_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>	
			
			<!-- civ buildings should have a CreateObjectDie to make a collapse version. -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>

			<!-- Lightning Weapon functionality -->
			<WeaponSetUpdate
				id="ModuleTag_Weapon01SetUpdate">
				<WeaponSlotTurret
					ID="1">
					<Weapon
						Ordering="PRIMARY_WEAPON"
						Template="EI_EasterIslandHeadDefenseTeslaGun"/>
					<TurretSettings
						TurretTurnRate="180"
						AllowsPitch="false"						
						MinIdleScanTime="0.0s"
						MaxIdleScanTime="0.0s"
						MinIdleScanAngle="30.0"
						MaxIdleScanAngle="50.0"
						ComeToHaltJiggle="3d">
						<TurretAITargetChooserData
							CanAcquireDynamicIfAssignedOutOfRange="true" />
					</TurretSettings>
				</WeaponSlotTurret>
			</WeaponSetUpdate>			
		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="NO"
				StateMachine="OffensiveStructureAIStateMachine">
				<UnitAITargetChooserData />
			</AIUpdate>
		</AI>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="2000"
				/>
		</Body>
		<Geometry
			IsSmall="false">
      
      <Shape
           Type= "BOX"
           MajorRadius = "20.2102"
           MinorRadius = "18.4499"
           Height = "70.724"
           ContactPointGeneration = "STRUCTURE" >
        <Offset
            x = "-0.254629"
            y = "-0.922922"
            z = "0.0" />
      </Shape>
      
		</Geometry>
		<AudioArraySound>
			<AudioEntry Sound="S08_SOV_EasterIslandHead_Damage" AudioType="soundOnDamaged" />
			<AudioEntry Sound="S08_SOV_EasterIslandHead_Damage" AudioType="soundOnReallyDamaged" />
		</AudioArraySound>
		<VisionInfo
			VisionRange="310"
			ShroudClearingRange="350" />
	</GameObject>

	<ObjectCreationList
		id="EI_EasterIslandHeadDefense_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="5"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>EI_EasterIslandHeadDefense_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>

	<!-- Soviet Moai Tesla Head Weapon (1.5s cycle) -->
	<WeaponTemplate
		id="SovietMoaiTeslaHeadGun"
		inheritFrom="SovietBaseDefenseAdvancedTeslaGun"
		RequiredAntiMask="ANTI_GROUND ANTI_STRUCTURE ANTI_WATER"
		ClipSize="1">
		<PreAttackDelay
			MinSeconds="0.9s"
			MaxSeconds="0.9s" />
		<Nuggets>
			<DamageNugget
				Damage="300.0"
				DamageType="TESLA"
				DamageFXType="SOVIET_TESLA"
				DeathType="ELECTROCUTED"
				DelayTimeSeconds="0.7s"/>
		</Nuggets>
	</WeaponTemplate>

	<!-- Buildable Soviet Moai Tesla Head -->
	<GameObject
		id="SovietMoaiTeslaHead"
		inheritFrom="EI_EasterIslandHeadDefense"
		Side="Soviet"
		EditorName="SovietMoaiTeslaHead"
		EnergyProduction="-75"
		KindOf="SELECTABLE STRUCTURE IMMOBILE CAN_CAST_REFLECTIONS AUTO_RALLYPOINT COVER KEEP_CLASSIFIED_WHEN_DEAD COVER CIVILIAN_BUILDING RESIST_EMP ALWAYS_VISIBLE_IN_RADAR FS_BASE_DEFENSE POWERED SCORE">
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="750"/>
		</ObjectResourceInfo>
		<GameDependency>
			<RequiredObject>SovietPowerPlantAdvanced</RequiredObject>
		</GameDependency>
		<Behaviors>
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpack"
				UnpackTime="15s" />
			<WeaponSetUpdate
				id="ModuleTag_Weapon01SetUpdate"
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">
				<WeaponSlotTurret
					ID="1">
					<Weapon
						Ordering="PRIMARY_WEAPON"
						Template="SovietMoaiTeslaHeadGun"/>
					<TurretSettings
						TurretTurnRate="180"
						AllowsPitch="false"
						MinIdleScanTime="0.0s"
						MaxIdleScanTime="0.0s"
						MinIdleScanAngle="30.0"
						MaxIdleScanAngle="50.0"
						ComeToHaltJiggle="3d">
						<TurretAITargetChooserData
							CanAcquireDynamicIfAssignedOutOfRange="true" />
					</TurretSettings>
				</WeaponSlotTurret>
			</WeaponSetUpdate>
		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="YES"
				xai:joinAction="Replace"
				StateMachine="OffensiveStructureAIStateMachine">
				<UnitAITargetChooserData />
			</AIUpdate>
		</AI>
	</GameObject>	
</AssetDeclaration>
