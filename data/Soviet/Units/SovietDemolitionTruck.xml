<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude">
	<!-- r16: Soviet Demolition Truck. r20: model / textures / portrait / button = vanilla Soviet Ore Collector (SovietMiner, SUHarvester).
	     It is NOT a harvester: inherits BaseVehicle (not BaseMiner), no HARVESTER KindOf, no OreMinerBehavior / dock AI, own command set (attack + sprint only). -->
	<Tags></Tags>
	<Includes>
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
		<!-- r20: model = vanilla Soviet Ore Collector (SUHarvester). Art is already in the vanilla streams -> reference only, nothing compiled into the mod. -->
		<Include type="reference" source="ART:SUHarvester_SKN.w3x" />
		<Include type="reference" source="ART:SUHarvester_D.xml" />
		<Include type="reference" source="ART:SUHarvester_IDLA.w3x" />
		<Include type="reference" source="ART:SUHarvester_MOVA.w3x" />
		<Include type="reference" source="ART:SUHarvester_WIDL.w3x" />
		<Include type="reference" source="ART:SUHarvester_WMOV.w3x" />
		<Include type="reference" source="ART:SUHarvester_WTRA.w3x" />
		<Include
			type="instance"
			source="DATA:BaseObjects/BaseVehicle.xml" />
	</Includes>
	<GameObject
		id="SovietDemolitionTruck"
		inheritFrom="BaseVehicle"
		SelectPortrait="Portrait_SovietHarvester_big"
		ButtonImage="Button_SovietHarvester_small"
		Side="Soviet"
		SubGroupPriority="20"
		EditorSorting="UNIT"
		BuildTime="10"
		CommandSet="SovietDemolitionTruckCommandSet"
		KindOf="SELECTABLE CAN_ATTACK AMPHIBIOUS CAN_CAST_REFLECTIONS SCORE VEHICLE CAN_BE_FAVORITE_UNIT"
		RadarPriority="UNIT"
		ProductionQueueType="VEHICLE"
		UnitCategory="VEHICLE"
		WeaponCategory="CANNON"
		VoicePriority="176"
		EditorName="SovietDemolitionTruck"
		Description="Desc:SovietDemolitionTruck"
		TypeDescription="Type:SovietDemolitionTruck"
		HealthBoxHeightOffset="15">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:SovietDemolitionTruck</DisplayName>
		<GameDependency>
			<RequiredObject>SovietPowerPlantAdvanced</RequiredObject>
		</GameDependency>
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="1200"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="JapanLightTransportVehicleArmor"
			DamageFX="VehicleDamageFX" />
		<!-- r20: same locomotors and speed as the mod Ore Collector (SovietMiner 75 on land and water); F sprint = x1.5 (AttributeModifier_JapanYariSprint SPEED 150%) -->
		<LocomotorSet
			Locomotor="TestReactiveLocomotorTANK"
			Condition="NORMAL"
			Speed="75.0" />
		<LocomotorSet
			Locomotor="SovietMinerWaterLocomotor"
			Condition="NORMAL"
			Speed="75.0" />
		<SkirmishAIInformation
			UnitBuilderStandardCombatUnit="true" />
		<Draws>
			<!-- r20: Ore Collector truck draw (vanilla SovietMiner ModuleTag_Draw), without the ore / armour sub-draws -->
			<TruckDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				TrackMarks="EXTnkTrack"
				TrackMarksOnlyWhenCorneringQuickly="false"
				TrackMarksLeftBone="Bone_Tire_L_03"
				TrackMarksRightBone="Bone_Tire_R_03"
				LeftFrontTireBone="Bone_Tire_L_01"
				RightFrontTireBone="Bone_Tire_R_01"
				MidLeftRearTireBone="Bone_Tire_L_02"
				MidRightRearTireBone="Bone_Tire_R_02"
				LeftRearTireBone="Bone_Tire_L_03"
				RightRearTireBone="Bone_Tire_R_03"
				TireRotationMultiplier="0.2"
				PowerslideRotationAddition="1.25">
				<TreadTerrainParticles>AmphibiousTankTerrainParticleMapping</TreadTerrainParticles>
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="SUHarvester_SKN" />
					<WeaponFireFXBone
						WeaponSlotID="1"
						WeaponSlotType="PRIMARY_WEAPON"
						BoneName="ROOTTRANSFORM" />
					<WeaponLaunchBone
						WeaponSlotID="1"
						WeaponSlotType="PRIMARY_WEAPON"
						BoneName="ROOTTRANSFORM" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="DAMAGED">
					<Model
						Name="SUHarvester_SKN" />
					<Texture
						Original="SUHarvester"
						New="SUHarvester_D" />
					<ParticleSysBone
						BoneName="Bone_Tire_R_03"
						FXParticleSystemTemplate="VehicleDamageSmoke"
						FollowBone="true" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					RetainSubObjects="true"
					ConditionsYes="REALLYDAMAGED">
					<Model
						Name="SUHarvester_SKN" />
					<Texture
						Original="SUHarvester"
						New="SUHarvester_D" />
					<ParticleSysBone
						BoneName="Bone_Tire_R_03"
						FXParticleSystemTemplate="VehicleDamageSmoke"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="Bone_Tire_R_03"
						FXParticleSystemTemplate="VehicleDamageFire"
						FollowBone="true" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="FORMATION_PREVIEW">
					<Model
						Name="SUHarvester_SKN" />
				</ModelConditionState>
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT"
					StateName="STATE_OnLAND">
					<Animation
						AnimationName="SUHarvester_IDLA"
						AnimationMode="LOOP"
						AnimationBlendTime="15" />
					<Script>
						Prev = CurDrawablePrevAnimationState()
						if Prev == "STATE_OnWater" and Prev ~= "TRANS_toLand" then CurDrawableSetTransitionAnimState("TRANS_toLand")	end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="MOVING OVER_WATER"
					StateName="STATE_OnWater">
					<Animation
						AnimationName="SUHarvester_WMOV"
						AnimationMode="LOOP"
						AnimationBlendTime="15" />
					<Script>
						Prev = CurDrawablePrevAnimationState()
						if Prev == "STATE_OnLAND" and Prev ~= "TRANS_" then CurDrawableSetTransitionAnimState("TRANS_toWater")	end
					</Script>
					<ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="StingrayWaterWake"
						FollowBone="false" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="MOVING"
					StateName="STATE_OnLAND">
					<Animation
						AnimationName="SUHarvester_MOVA"
						AnimationMode="LOOP" />
					<Script>
						Prev = CurDrawablePrevAnimationState()
						if Prev == "STATE_OnWater" and Prev ~= "TRANS_toLand" then CurDrawableSetTransitionAnimState("TRANS_toLand")	end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="OVER_WATER"
					StateName="STATE_OnWater">
					<Animation
						AnimationName="SUHarvester_WIDL"
						AnimationMode="LOOP"
						AnimationBlendTime="15" />
					<Script>
						Prev = CurDrawablePrevAnimationState()
						if Prev == "STATE_OnLAND" and Prev ~= "TRANS_toWater" then CurDrawableSetTransitionAnimState("TRANS_toWater")	end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_TRANSITION"
					StateName="TRANS_toWater">
					<Animation
						AnimationName="SUHarvester_WTRA"
						AnimationMode="ONCE"/>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_TRANSITION"
					Flags="START_FRAME_LAST"
					StateName="TRANS_toLand">
					<Animation
						AnimationName="SUHarvester_WTRA"
						AnimationMode="ONCE_BACKWARDS" />
				</AnimationState>
			</TruckDraw>
		</Draws>
		<Behaviors>
			<WeaponSetUpdate
				id="ModuleTag_WeaponSetUpdate">
				<WeaponSlotHardpoint
					ID="1">
					<Weapon
						Ordering="PRIMARY_WEAPON"
						Template="SovietDemolitionTruckDetonateWeapon" />
				</WeaponSlotHardpoint>
			</WeaponSetUpdate>
			<Physics
				id="ModuleTag_Physics" />
			<!-- speed boost: x1.5 for 5s (AttributeModifier_JapanYariSprint), 10s cooldown -->
			<MovementSpecialPower
				id="ModuleTag_DemolitionTruckSprint"
				SpecialPowerTemplate="SpecialPower_SovietDemolitionTruckSprint"
				AttributeModifier="AttributeModifier_JapanYariSprint"
				AttributeModifierAffectsSelf="true"
				MovementType="NONE"
				Duration="5s" />
			<!-- r20f: the truck is its own projectile during the ram (Yari ModuleTag_KamikazeProjectile flags; heights 0 = stays on the ground, no rise).
			     DONT_DETONATE_WITHOUT_COLLISION: if the target moves out of the way the truck lands and survives; MaxDistanceToTravel caps the dash. -->
			<!-- r20g: DONT_DETONATE_WITHOUT_COLLISION removed (Final Squadron flags): the dash always ends in a detonation, at the target or where the target was, so the truck can never land next to the target and park. -->
			<BezierProjectile
				id="ModuleTag_DemolitionTruckRamProjectile"
				Flags="ORIENT_TO_FLIGHT_PATH DETONATE_CALLS_KILL"
				FirstHeightMin="0"
				FirstHeightMax="0"
				SecondHeightMin="0"
				SecondHeightMax="0"
				FirstPercentIndent="10%"
				SecondPercentIndent="90%"
				BounceCount="0"
				PreLandingStateTime="0.1s"
				FlightPathAdjustDistPerSecond="100.0"
				MaxDistanceToTravel="200.0" />
			<!-- explodes on death (also after self-destructing on attack): medium time bomb blast -->
			<FireWeaponWhenDead
				id="ModuleTag_DemolitionTruckDeathWeapon"
				DeathWeapon="SovietDemolitionTruckDeathWeapon"
				InitiallyActive="true">
				<DieMuxData
					DeathTypes="ALL" />
			</FireWeaponWhenDead>
			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="SBMiner_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>
			<DestroyDie
				id="ModuleTag_Die">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="YES"
				StateMachine="UnitAIStateMachine"/>
		</AI>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="400" />
		</Body>
		<Geometry>
			<Shape
				Type="BOX"
				MajorRadius="20.0"
				MinorRadius="10.0"
				Height="15.0"
				ContactPointGeneration="VEHICLE" />
		</Geometry>
		<AudioArraySound>
			<AudioEntry
				Sound="SOV_OreCollector_MoveStart"
				AudioType="soundMoveStart" />
		</AudioArraySound>
		<VisionInfo
			VisionRange="300"
			ShroudClearingRange="300" />
		<CrusherInfo
			id="id_CrusherInfo"
			CrusherLevel="0"
			CrushEqualLevelProps="true"
			CrushableLevel="50" />
	</GameObject>
</AssetDeclaration>
