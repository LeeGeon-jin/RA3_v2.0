<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- r20q11 (2026-11-19, user design hasBomb): the invisible 0 s medium time bomb spawned by the Soviet Demolition Truck
	     (attack: WeaponOCLNugget in SovietDemolitionTruckDetonateWeapon; death without GENERIC_TOGGLE_STATE: truck CreateObjectDie).
	     Invisible medium time bomb = vanilla AlliedTimeBombLvl2 (death weapon AlliedTimeBomb_Level2) without model / sounds.
	     Countdown 0 s: fires its fuse at once, dies, and its death fires the medium time bomb blast, which also hits the truck (ALLIES). -->
	<Tags></Tags>
	<Includes>
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
		<Include
			type="instance"
			source="DATA:BaseObjects/BaseObject.xml" />
	</Includes>

	<GameObject
		id="SovietDemolitionTruckBomb"
		inheritFrom="BaseObject"
		Side="Soviet"
		EditorSorting="SYSTEM"
		IsTrainable="false"
		KindOf="IMMOBILE NO_COLLIDE NOT_AUTOACQUIRABLE IGNORE_FOR_VICTORY CANNOT_BE_DETECTED"
		EditorName="SovietDemolitionTruckBomb">
		<DisplayName>SovietDemolitionTruckBomb</DisplayName>
		<ArmorSet
			Armor="AlliedTimeBombArmor" />
		<LocomotorSet
			Locomotor="SpecialPowerAllTerrainValidLocomotor"
			Condition="NORMAL"
			Speed="0.0" />
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics" />
			<!-- countdown 0 s. OneShot FireWeaponUpdate = vanilla NanoSwarmHiveEffect. -->
			<FireWeaponUpdate
				id="ModuleTag_Fuse">
				<FireWeaponNugget
					WeaponName="SovietDemolitionTruckBombFuse"
					OneShot="true" />
			</FireWeaponUpdate>
			<!-- = vanilla AlliedTimeBombLvl2 ModuleTag_FinalWeapon: medium time bomb blast -->
			<FireWeaponWhenDead
				id="ModuleTag_FinalWeapon"
				InitiallyActive="true"
				DeathWeapon="AlliedTimeBomb_Level2">
				<DieMuxData
					DeathTypes="ALL" />
			</FireWeaponWhenDead>
			<DestroyDie
				id="ModuleTag_Die">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="NO" />
		</AI>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="1000.0" />
		</Body>
		<Geometry
			IsSmall="true">
			<Shape
				Type="CYLINDER"
				MajorRadius="1.0"
				Height="1.0" />
		</Geometry>
	</GameObject>
	<!-- r20q11: spawns the bomb at the source object (the truck); no CREATE_AT_TARGET -->
	<ObjectCreationList
		id="OCL_SovietDemolitionTruckBomb">
		<CreateObject>
			<CreateObject>SovietDemolitionTruckBomb</CreateObject>
		</CreateObject>
	</ObjectCreationList>
</AssetDeclaration>
