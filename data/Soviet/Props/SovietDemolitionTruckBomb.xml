<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- r20n_truck: the one bomb in the Soviet Demolition Truck "bomb bay".
	     Hidden, 0 s medium time bomb: no model, no FX, no sound; it dies the frame after it is created and its death fires
	     SovietDemolitionTruckDeathWeapon (= AlliedTimeBomb_Level2 blast 1000 / taper 600 / radius 200 EXPLOSIVE + the already approved Desolator fallout).
	     RadiusDamageAffects ENEMIES NEUTRALS ALLIES -> the truck (same player = ally, 400 HP, BaseVehicleArmor EXPLOSIVE 100%) dies in the blast.
	     Released by (a) the truck attack weapon (WeaponOCLNugget) and (b) the truck CreateObjectDie, which is skipped once the bay is empty
	     (truck status EXPLOSIVES_DETONATING, set by AttributeModifier_SovietDemolitionTruckBayEmpty when it fires).
	     Template = vanilla BaseTimeBombSeed (invisible time bomb seed) without FX_TimeBombChrono / ambient loop;
	     0 s lifetime = vanilla bridge *_Dying props ("Since the death triggers the weapon, we kill this object immediately").
	     Owner = the truck's player (an OCL cannot create a neutral object here), so kills/XP count for the truck owner. -->
	<Tags></Tags>
	<Includes>
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
		<Include
			type="instance"
			source="DATA:BaseObjects/BaseObject.xml" />
	</Includes>

	<!-- created at the truck itself (no CREATE_AT_TARGET): against a building the blast centre stays on the truck, not on the building centre -->
	<ObjectCreationList
		id="OCL_SovietDemolitionTruckBomb">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="ON_GROUND_ALIGNED USE_WATER_SURFACE"
			Count="1">
			<CreateObject>SovietDemolitionTruckBomb</CreateObject>
		</CreateObject>
	</ObjectCreationList>

	<GameObject
		id="SovietDemolitionTruckBomb"
		inheritFrom="BaseObject"
		Side="Soviet"
		EditorSorting="SYSTEM"
		IsTrainable="false"
		KindOf="IMMOBILE NO_COLLIDE NOT_AUTOACQUIRABLE IGNORE_FOR_VICTORY CANNOT_BE_DETECTED UNATTACKABLE"
		EditorName="SovietDemolitionTruckBomb">
		<DisplayName>SovietDemolitionTruckBomb</DisplayName>
		<ArmorSet
			Armor="BaseVehicleArmor" />
		<!-- vanilla BaseTimeBombSeed: locomotor only validates terrain (land / water), no speed -->
		<LocomotorSet
			Locomotor="SpecialPowerAllTerrainValidLocomotor"
			Condition="NORMAL"
			Speed="0.0" />
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics" />
			<!-- 0 s: dies right away (vanilla AS_Bridge_Dying etc. use MinLifetime/MaxLifetime 0s for "die and fire the death weapon") -->
			<LifetimeUpdate
				id="ModuleTag_LifetimeUpdate"
				MinLifetime="0s"
				MaxLifetime="0s"
				DeathType="NORMAL"
				IgnoreProjectileState="true" />
			<FireWeaponWhenDead
				id="ModuleTag_BombBlast"
				DeathWeapon="SovietDemolitionTruckDeathWeapon"
				InitiallyActive="true">
				<DieMuxData
					DeathTypes="ALL" />
			</FireWeaponWhenDead>
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="NO" />
		</AI>
		<Body>
			<PropBody
				id="ModuleTag_PropBody" />
		</Body>
		<Geometry
			IsSmall="true">
			<Shape
				Type="CYLINDER"
				MajorRadius="1.0"
				Height="1.0" />
		</Geometry>
	</GameObject>
</AssetDeclaration>
