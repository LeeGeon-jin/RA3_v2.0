<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance">
	<Tags></Tags>
	<Includes>
		<Include type="instance" source="DATA:BaseObjects/BaseCivilianStructureNoGarrisonDestructible.xml" />
		<Include type="instance" source="DATA:Civilian/Yucatan_YU/Props/YU_HotelDebris.xml" />
		<Include type="instance" source="DATA:Civilian/Kremlin_KR/Props/KR_GreatKremlinPalace_Collapse.xml" />
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" />
	</Includes>
	<GameObject
		id="SovietGreatKremlinPalaceBuildable"
		inheritFrom="BaseCivilianStructureNoGarrisonDestructible"
		EditorName="SovietGreatKremlinPalaceBuildable"
		KindOf="-NOT_AUTOACQUIRABLE +AUTO_ACQUIRABLE_BY_AI"
    	EditorSorting="STRUCTURE"
		Browser="REGION Kremlin_KR STRUCTURE"
		Side="Soviet"
		BuildTime="0"
		EnergyProduction="0"
		MaxSimultaneousOfType="1"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE">
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="2000"/>
		</ObjectResourceInfo>

		<!-- Preserve original two ArmorSet from BaseCivilianStructure parent -->
		<ArmorSet
			id="DefaultArmor"
			Armor="StructureArmor"
			DamageFX="GenericStructureDamageFX" />
		<ArmorSet
			Armor="CryoBeamFrozenArmor"
			DamageFX="VehicleDamageFX"
			Conditions="SECONDARY_DAMAGE"/>

		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="false"
				AffectedByStealth="false"
				ExtraPublicBone="BoneGarrisonWall01 BoneGarrisonWall02 BoneGarrisonWall03 BoneGarrisonWall04 BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18	BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20 BONEGARRISON01 BONEGARRISON02 BONEGARRISON03 BONEGARRISON04 BONEGARRISON05 BONEGARRISON06 BONEGARRISON07 BONEGARRISON08 BONEGARRISON09 BONEGARRISON10 BONEGARRISON11 BONEGARRISON12">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="KR_GreatKremlinPalace_A" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="RUBBLE">
					<Model
						Name="" />
				</ModelConditionState>

				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<!-- no anim -->
				</AnimationState>

			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics"/>


			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="YU_HotelDebris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>


			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_XLarge" />
			</FXListBehavior>


			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="KR_GreatKremlinPalace_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>


			<!-- Copied from BaseCivilianStructure parent (Soviet rules preserve death) -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>

			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpack"
				UnpackTime="20s" />
		</Behaviors>
		<Body>
			<ActiveBody
				id="DefaultBody"
				MaxHealth="=$CIV_HEALTH_XLARGE" />
		</Body>
		<Geometry
			IsSmall="false">
      <Shape
     Type= "BOX"
     MajorRadius = "131.481"
     MinorRadius = "36.8328"
     Height = "112.28"
     ContactPointGeneration = "STRUCTURE" >
        <Offset
            x = "0.351135"
            y = "3.37231"
            z = "0.0" />
      </Shape>			
		</Geometry>
		<AudioArraySound>
			<AudioEntry Sound="HumanFaction_MediumBuilding_LightDamageMS" AudioType="soundOnDamaged" />
			<AudioEntry Sound="HumanFaction_MediumBuilding_HeavyDamageMS" AudioType="soundOnReallyDamaged" />
		</AudioArraySound> 
	</GameObject>

	<ObjectCreationList
		id="KR_GreatKremlinPalace_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>KR_GreatKremlinPalace_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>		
</AssetDeclaration>
