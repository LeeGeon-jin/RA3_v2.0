<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance" xmlns:xi="http://www.w3.org/2001/XInclude">
	<Tags></Tags>
	<Includes>
		<Include type="instance" source="DATA:BaseObjects/BaseSovietStructure.xml" />
		<Include type="all"	source="ART:GE_SovietVIPBunkerSubStructure.W3X" />
		<Include type="instance" source="DATA:Civilian/Yucatan_YU/Props/YU_HotelDebris.xml" />
		<Include type="instance" source="DATA:Civilian/Geneva_GE/Props/GE_SovietVIPBunkerSubStructure_Collapse.xml" />
		
	</Includes>
	<GameObject
		id="SovietCloningCenter"
		inheritFrom="BaseSovietStructure"
		Side="Soviet"
		EditorName="SovietCloningCenter"	
    	EditorSorting="STRUCTURE"
		Browser="STRUCTURE"
		KindOf="+AIRCRAFT_PATH_AROUND"
		SelectPortrait="Portrait_Soviet_VIPBunker"
		ButtonImage="Button_Soviet_VIPBunker"
		BuildTime="0.0"
		EnergyProduction="-100"
		MaxSimultaneousOfType="1"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE"
		TypeDescription="Type:SovietCloningCenter"
		Description="Desc:SovietCloningCenter">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:SovietCloningCenter</DisplayName>
		<GameDependency>
			<RequiredObject>SovietTechStructure</RequiredObject>
		</GameDependency>
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="2500"/>
		</ObjectResourceInfo>
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				ExtraPublicBone="BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18 BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="GE_SovietVIPBunkerSubStructure" />
				</ModelConditionState>
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<Animation
						AnimationName="GE_SovietVIPBunkerSubStructure"
						AnimationMode="LOOP" />
				</AnimationState>				
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics"/>

			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpack"
				UnpackTime="30s" />

			<CaptureAndGiveUpgradeBehavior
				id="ModuleTag_CaptureAndGiveUpgrade">
				<UpgradeMap OwnershipAmount="1" ProvidedUpgrade="Upgrade_SovietCloning" />
				<UpgradeMap OwnershipAmount="2" ProvidedUpgrade="Upgrade_SovietCloning" />
				<UpgradeMap OwnershipAmount="3" ProvidedUpgrade="Upgrade_SovietCloning" />
				<UpgradeMap OwnershipAmount="4" ProvidedUpgrade="Upgrade_SovietCloning" />
				<UpgradeMap OwnershipAmount="5" ProvidedUpgrade="Upgrade_SovietCloning" />
				<UpgradeMap OwnershipAmount="6" ProvidedUpgrade="Upgrade_SovietCloning" />
			</CaptureAndGiveUpgradeBehavior>

			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericEngineerContain.xml" />

			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="AlliedBarracks_Debris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>

			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Medium" />
				<Event Index="onDeath" FX="FX_Audio_RA3LargeBuildingDie" />
			</FXListBehavior>

		<CreateObjectDie
			id="ModuleTag_CreateObjectDie"
			CreationList="SovietCloningCenter_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>	
			
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>				
		</Behaviors>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="2000"
				InitialHealth="2000" />
		</Body>
		
		<ArmorSet
			Armor="AlliedConYardArmor"
			DamageFX="FactionStructureDamageFX" />
		
		<Geometry
			IsSmall="false">
			<Shape 
				Type= "BOX"
				MajorRadius = "68.1424"
				MinorRadius = "43.79"
				Height = "125.42"
				ContactPointGeneration="STRUCTURE" >
				<Offset
					x = "0.856995"
					y = "-1.76774"
					z = "0.13446" />
			</Shape>
		</Geometry>
		<AudioArraySound>
			<AudioEntry Sound="" AudioType="soundOnDamaged" />
			<AudioEntry Sound="" AudioType="soundOnReallyDamaged" />
		</AudioArraySound>
				
	</GameObject>

	<ObjectCreationList
		id="SovietCloningCenter_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>GE_SovietVIPBunkerSubStructure_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>	
</AssetDeclaration>
